<?xml version="1.0" encoding="utf-8"?>
<!-- JugglucoNGmod: components of the phone `mod` build only (source set mobile + build type mod). The classes live in
     Common/src/mobile/java/tk/glucodata/mod/ (compiled by every phone build, never by the watch); declared here they
     start only in MOD. No package attribute: the namespace comes from Common/build.gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Watch block: our Data Layer messages from the watch (/mod/...). Exported like upstream's MessageReceiver:
             Google Play services delivers them; only our watch app (same package and signature) can send them. -->
        <service
            android:name="tk.glucodata.mod.watch.ModPhoneListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/mod/" android:scheme="wear" />
            </intent-filter>
            <!-- our watch app (capability of upstream's wear/res/values/wear.xml) became reachable: tick at once -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:host="*" android:path="/jugglucowatch" android:scheme="wear" />
            </intent-filter>
        </service>
        <!-- Watch block starter: on every process start registers the battery receiver and posts the /mod/tick
             cycle (WorkManager, after Application.onCreate). Not exported: nobody queries it. -->
        <provider
            android:name="tk.glucodata.mod.watch.ModWatchStarter"
            android:authorities="${applicationId}.mod-watch"
            android:exported="false" />
    </application>
</manifest>

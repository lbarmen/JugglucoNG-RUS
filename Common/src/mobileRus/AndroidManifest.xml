<?xml version="1.0" encoding="utf-8"?>
<!-- JugglucoNG-RUS: components of the phone `rus` build only (source set mobile + build type rus). The classes live in
     Common/src/mobile/java/tk/glucodata/rus/ (compiled by every phone build, never by the watch); declared here they
     start only in RUS. No package attribute: the namespace comes from Common/build.gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- CareLink starter: runs on every process start, schedules nothing until a CareLink sign-in exists -->
        <provider
            android:name="tk.glucodata.rus.carelink.RusCareLinkStarter"
            android:authorities="${applicationId}.rus-carelink"
            android:exported="false" />
        <!-- CareLink sign-in: the Medtronic page in a WebView. Not exported: only our own CareLink window opens it.
             configChanges - rotation, keyboard and theme do not recreate the window, or the page would reload and a
             code typed from mail or SMS would be lost. -->
        <activity
            android:name="tk.glucodata.rus.carelink.CareLinkLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density" />
        <!-- CareLink poll alarm: only our own PendingIntent sends it -->
        <receiver
            android:name="tk.glucodata.rus.carelink.CareLinkAlarmReceiver"
            android:exported="false" />
        <!-- CareLink: arm the poll alarm again after a reboot and an app update. With an intent filter Android 12+
             wants exported stated; only the system sends these actions (RECEIVE_BOOT_COMPLETED is in their manifest). -->
        <receiver
            android:name="tk.glucodata.rus.carelink.CareLinkBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- JugglucoNG-RUS (wear only). The watch face color styles reach their name strings and icons only
     through `private const val X = R.string/R.drawable...` (ColorStyleIdAndResourceIds.kt). R8 resource
     shrinking does not see these as uses: it drops the 7 *_style_name strings and the 6 color icons and
     passes 0 instead, so the watch face fails with "String resource ID #0x0" in getUserStyleSchema
     (upstream 1.3.2 wear has the same bug). rus/check-apk.py verifies the list against the sources.
     Remove this file once upstream fixes it. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/*_style_name,@drawable/red,@drawable/green,@drawable/blue,@drawable/yellow,@drawable/gray,@drawable/white" />
